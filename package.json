{
  "name": "nocte-lab",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --build",
    "simulate": "pnpm --filter @nocte/sim simulate",
    "benchmark": "pnpm --filter @nocte/sim benchmark",
    "enumerate": "pnpm --filter @nocte/sim enumerate",
    "depth": "pnpm --filter @nocte/sim depth",
    "depth:report": "pnpm --filter @nocte/sim depth:report"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.8.3",
    "tsx": "^4.19.3",
    "vitest": "^3.1.1"
  }
}
